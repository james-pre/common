{
	"name": "@james-pre/root",
	"version": "0.0.0",
	"private": true,
	"description": "Common packages",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"license": "LGPL-3.0-or-later",
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/common.git"
	},
	"homepage": "https://github.com/james-pre/common#readme",
	"bugs": {
		"url": "https://github.com/james-pre/common/issues"
	},
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"build": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "tsc -b --noEmit && eslint packages/*/src",
		"clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo docs"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"devDependencies": {
		"@commander-js/extra-typings": "^15.0.0",
		"@eslint/js": "^10.0.1",
		"@james-pre/config": "workspace:*",
		"@james-pre/monorepo": "workspace:*",
		"@types/node": "^24.7.0",
		"commander": "^15.0.0",
		"eslint": "^10.1.0",
		"globals": "^17.4.0",
		"prettier": "^3.2.5",
		"typedoc": "^0.28.18",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"utilium": "^3.7.0",
		"zod": "^4.5.0"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 120,
		"arrowParens": "avoid",
		"experimentalOperatorPosition": "start"
	}
}
