{
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "NodeNext",
		"target": "ES2022",
		"moduleResolution": "NodeNext",
		"noImplicitThis": true,
		"declaration": true,
		"isolatedModules": true,
		"strict": true,
		"typeRoots": ["./node_modules/@types", "./types"],
		"types": ["node", "commander"]
	},
	"exclude": ["node_modules"],
	"files": [],
	"references": [{ "path": "./packages/config" }, { "path": "./packages/systemd" }, { "path": "./packages/monorepo" }]
}
